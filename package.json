{
  "name": "projeto-cpb",
  "version": "1.0.0",
  "description": "Automação E2E — Registrar Clube CPB (Comitê Paralímpico Brasileiro)",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:ui": "cypress run --spec \"cypress/e2e/registro/**/*.cy.js\"",
    "cy:run:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "cy:run:headed": "cypress run --headed",
    "cy:clean": "node -e \"const fs=require('fs');const p='cypress/reports';if(fs.existsSync(p)){fs.readdirSync(p).filter(f=>f.endsWith('.html')||f.endsWith('.json')||f.endsWith('.mp4')||f.endsWith('.png')).forEach(f=>fs.unlinkSync(p+'/'+f))}\"",
    "cy:run:clean": "npm run cy:clean && cypress run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "mochawesome": "^7.1.4"
  }
}
